{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MioCraft",
  "version": "0.2.1",
  "identifier": "com.miocraft.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev --prefix ui",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "npm run build --prefix ui && npm run build --prefix mcp",
      "cwd": ".."
    }
  },
  "app": {
    "windows": [
      {
        "title": "MioCraft",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../mcp/dist/mio-craft-mcp.mjs": "mcp/mio-craft-mcp.mjs"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGQjFGOTM0QUMxMTYxNDQKUldSRVlSR3NOUG14THlwVHVnaEYrRnBRZDlKaGlYUm9rbmViY3ZIaDdzdGFNQVBqb211a2V4cXkK",
      "endpoints": [
        "https://github.com/Kokkogubben/mio-craft/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
